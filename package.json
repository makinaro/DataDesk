{
  "name": "datadesk",
  "productName": "DataDesk",
  "version": "0.0.1",
  "private": true,
  "description": "A local AI data analyst desktop app",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "duckdb:extensions": "node scripts/fetch-duckdb-extensions.mjs",
    "mcp:inspect": "electron-vite build && npx -y @modelcontextprotocol/inspector@2.8.0 --web -e DATADESK_CATALOG_PATH=.dev-data/catalog.json node out/main/mcp-server.js",
    "mcp:tools": "electron-vite build && npx -y @modelcontextprotocol/inspector@2.8.0 --cli node out/main/mcp-server.js --method tools/list -e DATADESK_CATALOG_PATH=.dev-data/catalog.json",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "package:dir": "electron-vite build && electron-builder --dir",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.286",
    "@anthropic-ai/sdk": "0.130.0",
    "@duckdb/node-api": "1.5.6-r.1",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@openai/agents-core": "0.18.0",
    "@openai/agents-openai": "0.18.0",
    "openai": "7.25.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-interpreter": "2.3.2",
    "vega-lite": "6.4.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  }
}
